# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Data (raw downloads + processed pipeline outputs, regenerated by the pipeline)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# data/dashboard/ est VOLONTAIREMENT tracke : instantane commite par
