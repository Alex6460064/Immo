# Local agent/session state, not project source
.claude/

# OS / editor
.DS_Store

# Secrets (cle API TypeSafe/Jev) : jamais versionnes -- voir spec #33 (ADR 0007 a venir, #39)
.env
.env.*
.streamlit/secrets.toml

# Site statique (#44) : dependances, build et donnees generees par pipeline/08_export_site.py
site/node_modules/
site/dist/
site/src/.observablehq/cache/
site/src/data/
